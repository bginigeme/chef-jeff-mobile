rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's recipes
      match /recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's favorites
      match /favorites/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's meal plans
      match /mealPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Public recipes (shared by users)
    match /publicRecipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Recipe history (user-specific)
    match /recipeHistory/{userId}/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // App recipes collection (AI and imported) - root level
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }
    
    // User's recipes - nested under users
    match /users/{userId}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's preferences and aggregates
    match /users/{userId}/preferences/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's ratings
    match /users/{userId}/ratings/{ratingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
} 